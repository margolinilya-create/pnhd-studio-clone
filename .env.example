# =============================================================================
# Next.js env (.env.local на dev, Vercel Project Settings → Environment Variables в проде)
# =============================================================================

# Supabase (обязательно)
# Возьми из Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase service-role (обязательно для admin-панели — branch feat/admin-foundation)
# Server-only, БЕЗ префикса NEXT_PUBLIC_ — иначе утечёт в браузер.
# Берётся из Supabase Dashboard → Project Settings → API → service_role.
# На public-сайте (main) не используется, но Next.js будет варнить при отсутствии,
# если включишь admin-middleware.
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# CORS / CSRF allowlist для Payload REST API (опц., если задан — используется
# вместо дефолтного списка localhost+studio.pnhd.ru).
# =============================================================================
# ALLOWED_ORIGINS=https://studio.pnhd.ru,https://pnhd-studio-clone-margolinilya-creates-projects.vercel.app,http://localhost:3000


# =============================================================================
# Deferred integrations (для будущих фаз — пока не используются)
# =============================================================================
# Bitrix24 (отложено): когда юзер готов настроить sync, hook добавляется в
# отдельном PR + ENV выставляется здесь.
# BITRIX_WEBHOOK_URL=

# Telegram уведомления (отложено).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# =============================================================================
# Payload CMS 3 (Phase 1b — scaffold, /admin-payload)
# =============================================================================

# Postgres connection string. На dev — Supabase direct/session-pooler connection.
# Берётся из Supabase Dashboard → Settings → Database → Connection string → URI.
# ВАЖНО: используй session mode (port 5432 или 6543 с ?pgbouncer=true&statement_cache_size=0)
# — transaction pooler ломает drizzle's prepared statements.
DATABASE_URI=postgres://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres

# Payload secret (32+ байт hex). Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=

# Публичный URL приложения (опционально, для CORS/CSRF на dev можно оставить пустым).
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# S3-совместимое хранилище для медиа (dev: Supabase Storage, prod: Yandex Object Storage).
# Supabase S3-keys: Dashboard → Storage → S3 Access Keys.
S3_ENDPOINT=https://YOUR-PROJECT-REF.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=payload-media
S3_FORCE_PATH_STYLE=true

# Bootstrap admin (один раз, для seed-скрипта `npm run payload:seed`).
PAYLOAD_BOOTSTRAP_EMAIL=mib@pnhd.ru
PAYLOAD_BOOTSTRAP_PASSWORD=


# =============================================================================
# Wave 0.1 — Live Preview
# =============================================================================
# Secret used by /api/preview to gate draftMode access. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure the same value in Payload admin Live Preview settings и в Vercel envs.
PREVIEW_SECRET=replace-with-hex32-secret
