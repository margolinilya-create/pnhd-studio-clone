# =============================================================================
# Next.js env (.env.local на dev, Vercel Project Settings → Environment Variables в проде)
# =============================================================================

# Supabase (обязательно)
# Возьми из Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key


# =============================================================================
# Supabase Edge Function `create-lead` (выставляются в Dashboard → Edge Functions → Secrets,
# НЕ здесь — Next.js их не видит, они нужны только Deno-runtime'у)
# Шпаргалка ниже на случай переустановки секретов.
# =============================================================================

# Bitrix24 incoming webhook. Когда задан — лиды летят в CRM (crm.lead.add).
# Формат: https://<portal>.bitrix24.ru/rest/<user_id>/<webhook_token>/
# BITRIX_WEBHOOK_URL=

# Telegram уведомления о новых лидах (опционально).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# CORS allowlist — CSV. Если не задан, Edge Function использует встроенный список
# (studio.pnhd.ru + наши Vercel-домены + localhost:3000 + regex *.vercel.app).
# ALLOWED_ORIGINS=https://studio.pnhd.ru,https://pnhd-studio-clone-margolinilya-creates-projects.vercel.app
